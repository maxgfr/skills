{
  "name": "maxgfr-skills",
  "version": "0.1.0",
  "private": true,
  "description": "maxgfr's process skills for agent-driven engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgfr/skills"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
